// Dépendances .NET du Labo, résolues dans paket.lock.
// Chaque projet liste celles qu'il utilise dans un paket.references à côté de lui.
//   dotnet tool restore && dotnet paket install
source https://api.nuget.org/v3/index.json
storage: none
framework: net10.0

nuget FSharp.Core ~> 10.0  // celle du compilateur du SDK 10 ; la 11 suppose un SDK 11

// tools/Labo.Cli : lancer Chrome sans écran pour capturer l'oracle
nuget UnMango.CliWrap.FSharp

// tests/Labo.Tests
nuget Expecto

// src/Labo.Interface (compilé par Fable)
nuget Fable.Core 5.3.0
nuget Fable.Browser.Dom 2.20.0
