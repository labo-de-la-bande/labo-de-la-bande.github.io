<Project Sdk="Microsoft.NET.Sdk">
  <!-- La CLI du Labo : labo doctor | generate | oracle. Voir README.md de ce dossier. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>labo</AssemblyName>
    <!-- outil .NET global : labo self install (Self.fs) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>labo</ToolCommandName>
    <PackageId>labo-cli</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Repo.fs" />
    <Compile Include="Csv.fs" />
    <Compile Include="..\..\src\Labo.Relais\Atelier.fs" Link="Relais/Atelier.fs" />
    <Compile Include="Schema.fs" />
    <Compile Include="Validate.fs" />
    <Compile Include="Generate.fs" />
    <Compile Include="Oracle.fs" />
    <Compile Include="Servir.fs" />
    <Compile Include="VerifierJs.fs" />
    <Compile Include="Assembler.fs" />
    <Compile Include="SourcesVerifier.fs" />
    <Compile Include="..\..\src\Labo.Relais\Proposition.fs" Link="Relais/Proposition.fs" />
    <Compile Include="Moderation.fs" />
    <Compile Include="Prenoms.fs" />
    <Compile Include="Idees.fs" />
    <Compile Include="Explorer.fs" />
    <Compile Include="Publier.fs" />
    <Compile Include="RelaisDeployer.fs" />
    <Compile Include="AtelierCli.fs" />
    <Compile Include="Rumeurs.fs" />
    <Compile Include="Self.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <!-- les formes des données, sans dépendre du F# généré -->
    <ProjectReference Include="..\..\src\Labo.Types\Labo.Types.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
