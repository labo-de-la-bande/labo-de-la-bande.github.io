<Project Sdk="Microsoft.NET.Sdk">
  <!-- Le jeu en mode texte, pour essayer la boucle avant le graphisme : labo-jouer [tranche] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>labo-jouer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Explorer.fs" />
    <Compile Include="Sensibilite.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Labo.Jeu\Labo.Jeu.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
