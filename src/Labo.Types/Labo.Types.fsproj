<Project Sdk="Microsoft.NET.Sdk">
  <!-- Les formes des données du jeu, partagées par la CLI (qui les lit dans data/) et par
       Labo.Data (qui en contient les valeurs générées). Écrit à la main. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; **/*.fs" PackagePath="fable/" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
