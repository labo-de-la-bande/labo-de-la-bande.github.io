<Project Sdk="Microsoft.NET.Sdk">
  <!-- L'interface du jeu, compilée par Fable en modules JavaScript dans jeu/js/ :
       dotnet fable src/Labo.Interface -o jeu/js -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Html.fs" />
    <Compile Include="Textes.fs" />
    <Compile Include="Territoire.fs" />
    <Compile Include="..\Labo.Relais\Proposition.fs" Link="Relais/Proposition.fs" />
    <Compile Include="..\Labo.Relais\Atelier.fs" Link="Relais/Atelier.fs" />
    <Compile Include="Relais.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Formulaire.fs" />
    <Compile Include="Proposer.fs" />
    <Compile Include="Prenom.fs" />
    <Compile Include="AtelierPage.fs" />
    <Compile Include="Mesure.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Labo.Jeu\Labo.Jeu.fsproj" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
