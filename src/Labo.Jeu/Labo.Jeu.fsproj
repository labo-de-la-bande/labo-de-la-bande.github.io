<Project Sdk="Microsoft.NET.Sdk">
  <!-- Le moteur de jeu : les révolutions, les situations, le conseil, la réputation, posés sur le
       moteur du modèle. Pur, sans E/S ; compilé en .NET et par Fable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Options.fs" />
    <Compile Include="Scene.fs" />
    <Compile Include="Partie.fs" />
    <Compile Include="Journal.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Labo.Engine\Labo.Engine.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; **/*.fs" PackagePath="fable/" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
