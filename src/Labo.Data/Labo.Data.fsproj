<Project Sdk="Microsoft.NET.Sdk">
  <!-- Données du jeu, générées depuis data/ par `labo generate`. Ne pas éditer Generated/ :
       changer les CSV et régénérer. Compilé en .NET (CLI, tests) et par Fable (le jeu). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="Generated/Sources.fs" />
    <Compile Include="Generated/Jauges.fs" />
    <Compile Include="Generated/Leviers.fs" />
    <Compile Include="Generated/Liens.fs" />
    <Compile Include="Generated/Pays.Fr.fs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="*.fsproj; **/*.fs" PackagePath="fable/" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
